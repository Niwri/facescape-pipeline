# FaceScape pipeline paths, read by facescape_paths.py. Copy to .env and edit for this cluster.
# Every key is required. A variable already set in the shell overrides the .env value (handy for sandbox runs).
# The FACESCAPE_* roots must match FaceView/backend/.env -- run `python facescape_paths.py` to check.

# Code in this repo (absolute paths to the folders next to this one)
FACEVIEW_ROOT="/path/to/facescape_pipeline/FaceView"
WRAP_SCRIPT_ROOT="/path/to/facescape_pipeline/wrap_script"
AVA256_SHARED_ROOT="/path/to/facescape_pipeline/ava256_shared"

# FaceScape multiview data: raw download (never modified) and the working copy every phase writes into
FACESCAPE_RAW_IMAGES_ROOT="/data/facescape/multiview/images/fsmview_trainset"
FACESCAPE_RAW_SHAPE_ROOT="/data/facescape/multiview/shape/fsmview_trainset"
FACESCAPE_IMAGES_ROOT="/work/facescape/multiview/images/fsmview_trainset"
FACESCAPE_SHAPE_ROOT="/work/facescape/multiview/shape/fsmview_trainset"

# Outputs
FACESCAPE_OUTPUT_ROOT="/work/output/facescape"
POINT_OVERLAY_RENDERS_FACESCAPE_ROOT="/work/point_overlay_renders_facescape"
FINAL_WRAPPED_BACKUP_ROOT="/work/final_wrapped_data_backup_pre_rewrap"
INVALID_PAIRS_PATH="/work/facescape/invalid_pairs.json"
SANITY_RENDER_ROOT="/work/temp_renders"

# Shared data, models, tools
LANDMARK_LINES_PATH="/work/landmark_lines.npy"
RAFT_CHECKPOINT_PATH="/models/raft_large_C_T_SKHT_V2-ff5fadd5.pth"
SAPIENS_CHECKPOINT_ROOT="/models/sapiens2_host"
SAPIENS_PYTHON="/envs/faceview_sapiens_venv/bin/python"
VENV_PYTHON="/envs/faceview_venv/bin/python"          # faceview_venv interpreter (phases 1, 3, 4; shell wrappers)
WrapCmd="/tools/Faceform_Wrap_Linux/WrapCmd"
WrapLicense="/tools/Faceform_Wrap_License.lic"
